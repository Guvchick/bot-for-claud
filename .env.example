###############################################################################
# Telegram-бот для Nextcloud — пример конфигурации.
# Скопируйте этот файл в .env и заполните значения:  cp .env.example .env
# Формат: КЛЮЧ=значение. Кавычки не нужны. Строки с # — комментарии.
# [ОБЯЗАТЕЛЬНО] — без этого бот не запустится. [опционально] — можно не трогать.
###############################################################################


###############################################################################
# Telegram-бот
###############################################################################

# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather.
BOT_TOKEN=123456:telegram-bot-token

# [ОБЯЗАТЕЛЬНО] Telegram ID администраторов через запятую.
# Узнать свой ID можно у @userinfobot. Админ определяется именно по этому ID:
# у админов в главном меню появляется кнопка «Войти в панель».
ADMIN_IDS=123456789,987654321

# [опционально] По умолчанию используется публичный Telegram Bot API (лимит файла 20 МБ).
# Чтобы принимать большие файлы (до ~2 ГБ), включите локальный Bot API (tdlight):
#   COMPOSE_PROFILES=telegram-local
#   TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
#   TELEGRAM_FILE_BASE_URL=http://telegram-bot-api:8081/file
#   TELEGRAM_LOCAL_MODE=true
COMPOSE_PROFILES=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_FILE_BASE_URL=https://api.telegram.org/file
TELEGRAM_LOCAL_MODE=false

# [опционально] Нужны ТОЛЬКО при COMPOSE_PROFILES=telegram-local.
# Получить на https://my.telegram.org/apps. TELEGRAM_VERBOSITY — уровень логов tdlight.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_VERBOSITY=2

# [опционально] Переписывание пути для локального Bot API (--local mode).
# Нужно, когда getFile возвращает путь внутри контейнера Bot API, а бот видит тот же
# общий volume по другому пути. Обычно оставляют пустыми.
TELEGRAM_LOCAL_PATH_PREFIX=
TELEGRAM_BOT_PATH_PREFIX=


###############################################################################
# Nextcloud
###############################################################################

# [ОБЯЗАТЕЛЬНО] Публичный адрес облака — его видят пользователи в кнопке «Войти в облако».
NEXTCLOUD_URL=https://cloud.example.com

# [опционально] Внутренний адрес, по которому бот обращается к OCS/WebDAV API.
# Пусто = используется NEXTCLOUD_URL. Полезно, когда бот и Nextcloud в одной сети.
# Примеры:
#   NEXTCLOUD_INTERNAL_URL=http://nextcloud
#   NEXTCLOUD_INTERNAL_URL=http://host.docker.internal
#   NEXTCLOUD_INTERNAL_URL=https://cloud.example.com
NEXTCLOUD_INTERNAL_URL=

# [опционально] Используется docker-compose (extra_hosts), чтобы публичный домен
# облака указывал на host-gateway. Полезно, когда бот и Nextcloud на одном сервере.
NEXTCLOUD_HOSTNAME=cloud.example.com

# [ОБЯЗАТЕЛЬНО] Логин администратора Nextcloud и app-пароль.
# Создайте app password в Nextcloud: Настройки → Безопасность → «Пароль приложения».
# НЕ используйте обычный пароль от сессии — нужен именно app password.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=nextcloud-admin-app-password

# [опционально] Квота по умолчанию (в ГБ) для новых одобренных пользователей.
DEFAULT_QUOTA_GB=10


###############################################################################
# База данных и кеш
###############################################################################

# Параметры PostgreSQL (хранит пользователей, платежи, настройки, уведомления).
POSTGRES_DB=bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-please
POSTGRES_SSLMODE=disable

# Redis — хранит временные состояния диалогов Telegram.
REDIS_URL=redis://redis:6379/0

# [опционально, но рекомендуется] Ключ шифрования сохранённых паролей Nextcloud в БД.
# Задайте длинное случайное значение и НЕ меняйте его потом — иначе сохранённые
# пароли станут нечитаемыми. Пусто = пароли хранятся в открытом виде.
DATABASE_SECRET_KEY=

# [опционально] Папки для бекапов и логов внутри контейнера.
BACKUP_DIR=backups
LOG_DIR=logs

# [опционально] Минимальный уровень логов: debug | info | warn | error.
# debug — самый подробный (видны все служебные сообщения), info — по умолчанию.
LOG_LEVEL=info


###############################################################################
# Оповещения админов и группа логов
###############################################################################

# [опционально] Писать админам в личку о запуске бота и о крашах.
NOTIFY_ADMINS_ON_START=true
NOTIFY_ADMINS_ON_CRASH=true

# [опционально] ID Telegram-группы (или супергруппы) для логов. Обычно отрицательный,
# например -1001234567890. Туда уходит чистый поток событий: запуск, авторизации
# пользователей, платежи и краши. Добавьте бота в группу (лучше администратором).
# Пусто = группа логов отключена.
# Как узнать ID группы: добавьте в неё @username_to_id_bot или @getidsbot.
LOG_GROUP_ID=

# [опционально] Дополнительно пересылать в группу строки логов уровня WARN/ERROR
# (с ограничением частоты). INFO/DEBUG остаются только локально — уровни не смешиваются.
LOG_GROUP_FORWARD_ERRORS=true

# [опционально] Цвет логов в консоли: пусто/auto — авто, always/on — всегда,
# never/off — выключить. Переменная окружения NO_COLOR тоже учитывается.
# В файл логов цвет никогда не пишется (только чистый текст).
LOG_COLOR=


###############################################################################
# Блоки интерфейса (кнопки главного меню)
###############################################################################

# [опционально] false — полностью убрать кнопку «Поддержка».
ENABLE_SUPPORT_BLOCK=true
# Контакты поддержки, показываются в разделе «Поддержка».
SUPPORT_TELEGRAM=@support_username
SUPPORT_EMAIL=support@example.com

# [опционально] false — полностью убрать кнопку «Донат».
ENABLE_DONATE_BLOCK=true

# [опционально] false — полностью убрать кнопку «Промокод».
ENABLE_PROMO_BLOCK=true


###############################################################################
# Донаты: Telegram Stars
###############################################################################

# [опционально] Отдельная секция доната. false — скрыть Stars, остальные способы остаются.
TELEGRAM_STARS_ENABLED=true
# Суммы в звёздах, которые предлагаются кнопками (через запятую).
TELEGRAM_STARS_AMOUNTS=50,100,250


###############################################################################
# Донаты/оплата: Platega
###############################################################################

# [опционально] false — скрыть Platega, остальные способы оплаты остаются.
PLATEGA_ENABLED=true

# [опционально] Статическая ссылка на оплату. Если заполнены API-данные ниже, бот
# создаёт персональные ссылки Platega, а эту использует лишь как запасную кнопку.
PLATEGA_URL=

# [опционально] API-режим. Значения берутся в личном кабинете Platega.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
# Суммы в рублях для кнопок оплаты (через запятую).
PLATEGA_AMOUNTS_RUB=100,300,500
# Страницы, куда платёжка вернёт пользователя после оплаты/ошибки.
PLATEGA_RETURN_URL=https://your-domain.example/payments/success
PLATEGA_FAILED_URL=https://your-domain.example/payments/fail

# [опционально] Публичный URL вебхука Platega (для автоматической выдачи после оплаты).
# Пример: https://your-domain.example/webhooks/platega
# Тот же URL пропишите в настройках callback в кабинете Platega.
PLATEGA_CALLBACK_URL=

# [опционально] Публичный домен без пути. Используется для построения callback-URL
# у провайдеров, которым адрес передаётся при создании счёта (например, Heleket).
PUBLIC_WEBHOOK_BASE_URL=https://your-domain.example
# Адрес и порт, на котором бот слушает вебхуки платёжек.
WEBHOOK_LISTEN_ADDR=:8088
PLATEGA_WEBHOOK_PATH=/webhooks/platega
# Внешний порт для проброса в docker-compose.
WEBHOOK_PORT=8088


###############################################################################
# Оплата: Pally
###############################################################################
# Документация: https://pally.info/en/merchant/api
PALLY_ENABLED=false
PALLY_TOKEN=
PALLY_SHOP_ID=
PALLY_BASE_URL=https://pal24.pro
PALLY_CALLBACK_PATH=/webhooks/pally


###############################################################################
# Оплата: CryptoBot / Crypto Pay
###############################################################################
# Документация: https://help.send.tg/en/articles/10279948-crypto-pay-api
# Впишите в CRYPTOBOT_WEBHOOK_PATH секретный случайный сегмент и укажите тот же URL
# в @CryptoBot → Crypto Pay → My Apps → Webhooks.
CRYPTOBOT_ENABLED=false
CRYPTOBOT_TOKEN=
CRYPTOBOT_BASE_URL=https://pay.crypt.bot
CRYPTOBOT_WEBHOOK_PATH=/webhooks/cryptobot-change-this-secret


###############################################################################
# Оплата: Heleket
###############################################################################
# Документация: https://doc.heleket.com/
HELEKET_ENABLED=false
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_BASE_URL=https://api.heleket.com
HELEKET_CURRENCY=RUB
HELEKET_TO_CURRENCY=USDT
HELEKET_WEBHOOK_PATH=/webhooks/heleket

# [опционально] Произвольная внешняя ссылка для доната (кнопка «Донат» по ссылке).
DONATE_URL=


###############################################################################
# Фоновые задачи и лимиты
###############################################################################

# [опционально] Сколько дней хранить сжатые бекапы перед автоудалением.
BACKUP_RETENTION_DAYS=7

# [опционально] Интервал автоматического бекапа PostgreSQL (в часах).
AUTO_BACKUP_INTERVAL_HOURS=24

# [опционально] Интервал проверки, что одобренные пользователи ещё есть в Nextcloud (минуты).
# Если пользователя удалили из Nextcloud — запись удаляется и из базы бота.
NEXTCLOUD_SYNC_INTERVAL_MINUTES=60

# [опционально] Сколько файлов грузить параллельно. У премиум-пользователей приоритет в очереди.
UPLOAD_WORKERS=3

# [опционально] TTL кеша занятого места по каждому пользователю (секунды).
# Меньше — свежее в интерфейсе, больше — меньше нагрузки, если Nextcloud медленный.
QUOTA_CACHE_SECONDS=45

# [опционально] Лимит размера файла, который бот скачивает из Telegram (в МБ).
# Публичный Bot API — не больше ~20 МБ. С локальным Bot API (--local) можно до 2000,
# что позволяет принимать файлы примерно до 2 ГБ.
TELEGRAM_MAX_DOWNLOAD_MB=20

# [опционально] Файлы крупнее этого размера (в МБ) грузятся в Nextcloud по частям
# (чанковая загрузка WebDAV v2). Это нужно для надёжной загрузки файлов больше ~1 ГБ.
UPLOAD_CHUNK_SIZE_MB=96
# [опционально] Общий таймаут на одну большую передачу скачивание/загрузка (в минутах).
# Отдельный HTTP-клиент с этим таймаутом не даёт большой загрузке оборваться по 90 сек.
UPLOAD_TIMEOUT_MINUTES=180

# [опционально] Срок премиум-иконки после оплаты или ручной выдачи админом (в днях).
PREMIUM_DAYS=30


###############################################################################
# Стикеры и редактируемые тексты
###############################################################################

# [опционально] Где хранятся пользовательские стикеры/оформление событий.
# Это файл, а не env, чтобы оформление переживало перезапуск.
STICKER_STORE_FILE=data/stickers.json

# [опционально] Где хранятся редактируемые из Telegram тексты сообщений и кнопок.
CONTENT_STORE_FILE=data/content.json

# [опционально] Тестовый пак стикеров/эмодзи, показываемый в админке при настройке.
STICKER_PACK_URL=https://t.me/addemoji/CPT_Emoji


###############################################################################
# Баннеры меню
###############################################################################
# Баннер — это картинка, которую бот показывает над конкретным меню.
# Как пользоваться:
#   1. Положите картинки (JPG/PNG, до 10 МБ) в папку BANNER_DIR (по умолчанию banners/).
#   2. Укажите имя файла в нужной переменной BANNER_* ниже (или абсолютный путь).
#   3. Перезапустите бота — он загрузит баннер один раз и запомнит Telegram file_id
#      в BANNER_CACHE_FILE. При изменении картинки она будет загружена заново.
# Пустое значение = у этого меню баннера нет (поведение как раньше).

# Папка с картинками баннеров и файл кеша file_id.
BANNER_DIR=banners
BANNER_CACHE_FILE=data/banners.json

# Главное меню / личный кабинет.
BANNER_MENU=
# Экран «Доступ открыт» (выдача нового аккаунта).
BANNER_APPROVED=
# Раздел «Поддержка».
BANNER_SUPPORT=
# Раздел «Донат».
BANNER_DONATE=
# Раздел «Инфо».
BANNER_INFO=
# Раздел «Уведомления».
BANNER_NOTIFICATIONS=
# Админ-панель.
BANNER_ADMIN=
# Меню выбора языка.
BANNER_LANGUAGE=
